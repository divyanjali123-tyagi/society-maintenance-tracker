# ---------- Server ----------
PORT=5000
CLIENT_URL=http://localhost:5173

# ---------- Database ----------
# For local/demo use SQLite (zero setup):
DB_PROVIDER=sqlite
DATABASE_URL="file:./dev.db"

# For production with Postgres (Render/Railway), use instead:
# DB_PROVIDER=postgresql
# DATABASE_URL="postgresql://user:password@host:5432/dbname"

# ---------- Auth ----------
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# ---------- Overdue detection ----------
# Number of days a complaint can stay non-resolved before it is flagged overdue
OVERDUE_THRESHOLD_DAYS=3

# ---------- Email (SMTP - any free provider, e.g. Gmail App Password, Mailtrap, Brevo) ----------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="Society Maintenance <no-reply@society.com>"

# Set to "true" to log emails to console instead of sending (useful for local dev)
EMAIL_DEBUG=true
